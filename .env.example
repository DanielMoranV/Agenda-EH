VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# OAuth 2.0 Web Client ID de Google Cloud (el mismo proyecto que Firebase).
# Necesario para renovar AUTOMÁTICAMENTE el token de Google Calendar / Gmail
# antes de que caduque (dura 1 hora) sin obligar al usuario a volver a loguearse.
#
# Dónde obtenerlo:
#   Google Cloud Console > APIs y servicios > Credenciales
#   > "ID de cliente de OAuth 2.0" de tipo "Aplicación web"
#   (Firebase crea uno automáticamente, suele llamarse "Web client (auto created by Google Service)")
#
# En esa credencial hay que añadir a "Orígenes de JavaScript autorizados":
#   http://localhost:5173
#   https://TU-DOMINIO-DE-HOSTING
#
# Si se deja vacío, la app sigue funcionando pero la renovación deja de ser
# silenciosa: mostrará un aviso con un botón "Reconectar" (un solo clic).
VITE_GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
